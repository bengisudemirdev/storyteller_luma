# Luma iOS — kopyala: cp Luma/Config/.env.example Luma/Config/.env
# Bu dosya repoda kalır; .env asla commit edilmez. Gerçek anahtarları yalnızca .env içine yazın.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
BACKEND_BASE_URL=https://your-api.example.com
REVENUECAT_API_KEY=YOUR_REVENUECAT_PUBLIC_SDK_KEY

# ElevenLabs: Convai agent → TTS (isteğe bağlı; boşsa masal okuyucu iOS AVSpeech kullanır)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
