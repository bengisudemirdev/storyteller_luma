# -----------------------------
# Server
# -----------------------------
PORT=3001
# Docker / VPS / PaaS: dış erişim için 0.0.0.0 (localhost dışarıdan görünmez)
HOST=0.0.0.0
# Reverse proxy (nginx, Caddy) arkasında: true veya 1
TRUST_PROXY=1
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb

# Public API base (Swagger "servers" + OpenAPI). Production örnek:
# API_BASE_URL=https://luma.beysemi.com
API_BASE_URL=http://localhost:3001

# -----------------------------
# Supabase
# -----------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use ONLY backend service role key. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase Storage
SUPABASE_STORAGE_BUCKET_STORIES=luma-stories-assets

# -----------------------------
# OpenAI
# -----------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
# Masal kapağı: openai.images.generate — gpt-image-1 veya dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1

# -----------------------------
# CORS
# -----------------------------
# Comma-separated list of allowed origins.
# For mobile, you typically need your dev machine origin during local testing.
# Production: kendi domain(ler)in. Boş bırakılırsa tüm origin’lere izin verilir (mobil için OK).
# Örnek: https://luma.beysemi.com
CORS_ORIGINS=

# -----------------------------
# Rate limiting
# -----------------------------
# Pencere: ms (900000 = 15 dk). Uygulama + Swagger aynı IP’de aynı limite girer.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Yerel geliştirme / Swagger denemesi: true yapınca /v1 rate limit kalkar. Production’da false bırak.
RATE_LIMIT_DISABLED=false

# Extra limiter for story generation
STORIES_GENERATE_RATE_LIMIT_WINDOW_MS=900000
STORIES_GENERATE_RATE_LIMIT_MAX=30

# -----------------------------
# Usage limits (per user, per day)
# -----------------------------
DAILY_FREE_STORY_LIMIT=3
DAILY_PREMIUM_STORY_LIMIT=50

# -----------------------------
# Swagger / OpenAPI (örn. https://luma.beysemi.com/docs/)
# Production’da güçlü şifre kullan; reverse proxy Basic Auth da ekleyebilirsin.
SWAGGER_ENABLED=true
SWAGGER_BASIC_AUTH_USERNAME=docs_user
SWAGGER_BASIC_AUTH_PASSWORD=change_this_strong_password

# -----------------------------
# Admin authorization (optional)
# -----------------------------
# Comma-separated list of admin emails. Used by requireAdmin middleware.
ADMIN_EMAILS=

